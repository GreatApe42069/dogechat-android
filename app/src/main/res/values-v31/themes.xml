<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ (API 31+) platform splash attributes -->
    <style name="Theme.DogechatAndroid" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- System-managed splash: black background + launcher icon centered -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Optional: duration in ms -->
        <item name="android:windowSplashScreenAnimationDuration">100</item>

        <!-- Keep edge-to-edge flags (actual bar colors enforced in MainActivity) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>